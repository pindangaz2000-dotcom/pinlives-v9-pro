# Copy to .env and fill in. Never commit .env — it is gitignored.
# Placeholders only: putting a real token in this file publishes it.

# ============================================================================
# REQUIRED — Telethon (the user account that reads private channels)
# Create an application at https://my.telegram.org/apps
# ============================================================================
TELETHON_API_ID=0000000
TELETHON_API_HASH=replace_with_your_api_hash
TELETHON_PHONE=+840000000000

# ============================================================================
# REQUIRED — Bot (the operator control panel)
# Token from @BotFather; your numeric user id from @userinfobot
# ============================================================================
TELEGRAM_BOT_TOKEN=000000000:replace_with_your_bot_token
TELEGRAM_ADMIN_ID=0000000000

# ============================================================================
# OPTIONAL — everything below has a working default
# ============================================================================

# API
BACKEND_URL=http://localhost:8000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Database: sqlite (default) or postgres
DB_TYPE=sqlite
DB_PATH=/tmp/pinlives_pro.db
# Used only when DB_TYPE=postgres
DB_USER=pinlives
DB_PASSWORD=change_me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pinlives_pro

# Login flow
SESSION_DIR=/tmp/telethon_sessions
OTP_TIMEOUT_SECONDS=600

# Cache and queue
OCR_CACHE_SIZE=500
OCR_CACHE_TTL_SECONDS=3600
MESSAGE_QUEUE_SIZE=5000
MAX_RETRIES=3

# Logging
LOG_LEVEL=INFO
LOG_FILE=/tmp/pinlives.log
SQL_ECHO=false

# Feature flags
ENABLE_MONITORING=true
ENABLE_PERSISTENCE=true
